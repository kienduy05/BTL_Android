<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Danh mục -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Danh mục *"
            android:textColor="#2D2F6B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input_rounded"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="14dp" />

        <!-- Tên bài tập -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên bài tập *"
            android:textColor="#2D2F6B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etPracticeName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input_rounded"
            android:hint="Nhập tên bài tập"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#2D2F6B"
            android:textColorHint="#A0A7C8"
            android:textSize="14sp"
            android:layout_marginBottom="14dp" />

        <!-- Mô tả -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mô tả"
            android:textColor="#2D2F6B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etPracticeDescription"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/bg_input_rounded"
            android:hint="Nhập mô tả (tùy chọn)"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:textColor="#2D2F6B"
            android:textColorHint="#A0A7C8"
            android:textSize="14sp"
            android:layout_marginBottom="14dp" />

        <!-- Thời gian & Số câu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thời gian (phút)"
                    android:textColor="#2D2F6B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etTimeLimit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="VD: 15"
                    android:inputType="number"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#2D2F6B"
                    android:textColorHint="#A0A7C8"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Số câu hỏi"
                    android:textColor="#2D2F6B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etTotalQuestions"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="VD: 10"
                    android:inputType="number"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#2D2F6B"
                    android:textColorHint="#A0A7C8"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- TIÊU ĐỀ CHỌN CÂU HỎI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chọn câu hỏi"
                android:textColor="#2D2F6B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSelectedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã chọn: 0"
                android:textColor="#5B7FFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Thông báo chưa chọn danh mục -->
        <TextView
            android:id="@+id/tvNoQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:background="@drawable/bg_input_rounded"
            android:text="Chọn danh mục để xem câu hỏi"
            android:textColor="#A0A7C8"
            android:textSize="12sp"
            android:visibility="visible" />

        <!-- ListView câu hỏi checkbox -->
        <ListView
            android:id="@+id/lvQuestionSelect"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:divider="@null"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>