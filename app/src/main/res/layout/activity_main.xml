<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFBFF"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <!-- Background decorative circles (top-left blob) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Blob 1: top-left -->
        <View
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="-60dp"
            android:layout_marginStart="-60dp"
            android:background="@drawable/main_shape_blob_blue"
            android:alpha="0.55"/>

        <!-- Blob 2: top-right -->
        <View
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-40dp"
            android:layout_marginEnd="-60dp"
            android:background="@drawable/main_shape_blob_purple"
            android:alpha="0.55"/>

        <LinearLayout
            android:id="@+id/layoutLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="56dp"
            android:paddingBottom="36dp">

            <!-- ===== LOGO / TITLE ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="36dp">

                <!-- Logo Icon Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="10dp"
                    app:cardBackgroundColor="#6C8EFF">

                    <!-- Replace with your actual logo ImageView -->
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_main_quiz_logo"
                        android:tint="#FFFFFF"/>

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/txtAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QuizApp"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#2D2F6B"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.01"
                    android:layout_gravity="center_horizontal"/>

                <TextView
                    android:id="@+id/txtSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đăng nhập để tiếp tục"
                    android:textSize="13sp"
                    android:textColor="#8A8FB5"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <!-- ===== EMAIL ===== -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email"
                app:startIconDrawable="@drawable/ic_main_email"
                app:startIconTint="#6C8EFF"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="#E4E7F8"
                app:boxStrokeWidthFocused="1.5dp"
                app:hintTextColor="#6C8EFF"
                android:layout_marginBottom="14dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtEmail"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:inputType="textEmailAddress"
                    android:textColor="#2D2F6B"
                    android:textSize="14sp"
                    android:background="#FFFFFF"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ===== PASSWORD ===== -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Mật khẩu"
                app:startIconDrawable="@drawable/ic_main_lock"
                app:startIconTint="#6C8EFF"
                app:endIconMode="password_toggle"
                app:endIconTint="#6C8EFF"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="#E4E7F8"
                app:boxStrokeWidthFocused="1.5dp"
                app:hintTextColor="#6C8EFF"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtPassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:inputType="textPassword"
                    android:textColor="#2D2F6B"
                    android:textSize="14sp"
                    android:background="#FFFFFF"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ===== FORGOT PASSWORD ===== -->
            <TextView
                android:id="@+id/txtForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quên mật khẩu?"
                android:textColor="#6C8EFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_gravity="end"
                android:layout_marginBottom="24dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"/>

            <!-- ===== LOGIN BUTTON ===== -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Đăng nhập"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6C8EFF"
                android:layout_marginBottom="28dp"
                app:cornerRadius="16dp"
                app:elevation="8dp"/>

            <!-- ===== DIVIDER ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E8EAFF"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  hoặc tiếp tục với  "
                    android:textSize="11sp"
                    android:textColor="#B0B5D8"
                    android:textStyle="bold"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E8EAFF"/>

            </LinearLayout>

            <!-- ===== SOCIAL LOGIN BUTTONS ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="28dp">

                <!-- Google Button -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnGoogle"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="#E4E7F8"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_main_google"
                            android:layout_marginEnd="6dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Google"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#4A4E7A"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Facebook Button -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnFacebook"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="#E4E7F8"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_main_facebook"
                            android:layout_marginEnd="6dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Facebook"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#4A4E7A"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- ===== REGISTER ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center">

                <TextView
                    android:id="@+id/txtNoAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bạn chưa có tài khoản? "
                    android:textSize="13sp"
                    android:textColor="#8A8FB5"/>

                <TextView
                    android:id="@+id/txtRegisterNow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đăng ký ngay"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#6C8EFF"/>

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</ScrollView>