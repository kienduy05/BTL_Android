<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tên danh mục *"
        android:textColor="#2D2F6B"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etCategoryName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_rounded"
        android:hint="Nhập tên danh mục"
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#2D2F6B"
        android:textColorHint="#A0A7C8"
        android:textSize="14sp"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mô tả"
        android:textColor="#2D2F6B"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etCategoryDescription"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/bg_input_rounded"
        android:hint="Nhập mô tả (tùy chọn)"
        android:inputType="textMultiLine"
        android:gravity="top"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:textColor="#2D2F6B"
        android:textColorHint="#A0A7C8"
        android:textSize="14sp"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="URL ảnh"
        android:textColor="#2D2F6B"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etCategoryImage"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_rounded"
        android:hint="Nhập URL ảnh (tùy chọn)"
        android:inputType="textUri"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#2D2F6B"
        android:textColorHint="#A0A7C8"
        android:textSize="14sp" />

</LinearLayout>