<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFBFF"
    android:fillViewport="true"
    tools:context=".Activities.ForgotPasswordActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Blob top left -->
        <View
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="-60dp"
            android:layout_marginTop="-60dp"
            android:alpha="0.55"
            android:background="@drawable/main_shape_blob_blue" />

        <!-- Blob top right -->
        <View
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-40dp"
            android:layout_marginEnd="-60dp"
            android:alpha="0.55"
            android:background="@drawable/main_shape_blob_purple" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="48dp"
            android:paddingEnd="28dp"
            android:paddingBottom="36dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#6C8EFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="10dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_main_lock"
                        android:tint="#FFFFFF" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/txtForgotTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.01"
                    android:text="Quên mật khẩu"
                    android:textColor="#2D2F6B"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtForgotSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Nhập email để nhận mã xác minh và đặt lại mật khẩu mới"
                    android:textAlignment="center"
                    android:textColor="#8A8FB5"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- EMAIL -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmailForgot"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Email"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="#E4E7F8"
                app:boxStrokeWidthFocused="1.5dp"
                app:hintTextColor="#6C8EFF"
                app:startIconDrawable="@drawable/ic_main_email"
                app:startIconTint="#6C8EFF">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtEmailForgot"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="#FFFFFF"
                    android:inputType="textEmailAddress"
                    android:textColor="#2D2F6B"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- BUTTON GET CODE -->
            <Button
                android:id="@+id/btnGetCode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="22dp"
                android:backgroundTint="#EAF0FF"
                android:text="Lấy mã xác nhận"
                android:textAllCaps="false"
                android:textColor="#4E6FEA"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="14dp" />

            <!-- VERIFY CODE -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilVerifyCode"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Nhập mã xác nhận"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="#E4E7F8"
                app:boxStrokeWidthFocused="1.5dp"
                app:hintTextColor="#6C8EFF"
                app:startIconDrawable="@drawable/ic_main_lock"
                app:startIconTint="#6C8EFF">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtVerifyCode"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="#FFFFFF"
                    android:inputType="number"
                    android:textColor="#2D2F6B"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- NEW PASSWORD -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNewPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Mật khẩu mới"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="#E4E7F8"
                app:boxStrokeWidthFocused="1.5dp"
                app:endIconMode="password_toggle"
                app:endIconTint="#6C8EFF"
                app:hintTextColor="#6C8EFF"
                app:startIconDrawable="@drawable/ic_main_lock"
                app:startIconTint="#6C8EFF">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="#FFFFFF"
                    android:inputType="textPassword"
                    android:textColor="#2D2F6B"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- CONFIRM NEW PASSWORD -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConfirmNewPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:hint="Xác nhận mật khẩu mới"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="#E4E7F8"
                app:boxStrokeWidthFocused="1.5dp"
                app:endIconMode="password_toggle"
                app:endIconTint="#6C8EFF"
                app:hintTextColor="#6C8EFF"
                app:startIconDrawable="@drawable/ic_main_lock"
                app:startIconTint="#6C8EFF">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtConfirmNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="#FFFFFF"
                    android:inputType="textPassword"
                    android:textColor="#2D2F6B"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- NOTE -->
            <TextView
                android:id="@+id/txtForgotNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="Mã xác nhận sẽ được dùng để kiểm tra quyền đổi mật khẩu trước khi cập nhật tài khoản."
                android:textAlignment="center"
                android:textColor="#9AA0C3"
                android:textSize="12sp" />

            <!-- CHANGE PASSWORD BUTTON -->
            <Button
                android:id="@+id/btnChangePassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="#6C8EFF"
                android:text="Đổi mật khẩu"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:elevation="8dp" />

            <!-- BACK TO LOGIN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center">

                <TextView
                    android:id="@+id/txtBackLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nhớ mật khẩu rồi? "
                    android:textColor="#8A8FB5"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtBackLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đăng nhập ngay"
                    android:textColor="#6C8EFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</ScrollView>